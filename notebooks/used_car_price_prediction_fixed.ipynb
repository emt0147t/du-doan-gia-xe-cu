    "def format_vnd_price(price_vnd):\n",
    "    \"\"\"Định dạng tiền tệ tiếng Việt trực quan.\"\"\"\n",
    "    if np.isnan(price_vnd) or price_vnd <= 0:\n",
    "        return \"N/A\"\n",
    "    ty = int(price_vnd // 1_000_000_000)\n",
    "    trieu = int(round((price_vnd % 1_000_000_000) / 1_000_000))\n",
    "    if ty > 0 and trieu > 0:\n",
    "        return f\"{ty} Tỷ {trieu} Triệu VNĐ ({price_vnd:,.0f} đ)\"\n",
    "    elif ty > 0:\n",
    "        return f\"{ty} Tỷ VNĐ ({price_vnd:,.0f} đ)\"\n",
    "    else:\n",
    "        return f\"{trieu} Triệu VNĐ ({price_vnd:,.0f} đ)\"\n",
    "\n",
    "def predict_single_car(pipe, car_dict):\n",
    "    \"\"\"Dự đoán giá cho một chiếc xe từ dictionary thông số.\"\"\"\n",
    "    d = dict(car_dict)\n",
    "    d[\"car_age\"] = max(0, 2024 - d[\"year\"])\n",
    "    d[\"is_zero_mileage\"] = 1 if d[\"mileage_km\"] == 0 else 0\n",
    "    d[\"is_luxury_brand\"] = 1 if d[\"brand\"] in LUXURY_BRANDS else 0\n",
    "    df_single = pd.DataFrame([d])\n",
    "    pred_log = pipe.predict(df_single)[0]\n",
    "    pred_vnd = np.exp(pred_log)\n",
    "    return pred_vnd\n",
    "\n",
    "demo_cars = [\n",
    "    {\n",
    "        \"brand\": \"Toyota\", \"model\": \"Vios\", \"year\": 2020, \"mileage_km\": 45000,\n",
    "        \"transmission\": \"Tự động\", \"fuel_type\": \"Xăng\", \"origin\": \"Trong nước\",\n",
