    "NUMERIC_FEATURES = [\n",
    "    \"year\", \"car_age\", \"mileage_km\", \"is_zero_mileage\",\n",
    "    \"engine_displacement_l\", \"seats\", \"doors\", \"is_luxury_brand\"\n",
    "]\n",
    "CATEGORICAL_FEATURES = [\n",
    "    \"brand\", \"model\", \"condition\", \"transmission\",\n",
    "    \"origin\", \"body_type\", \"fuel_type\"\n",
    "]\n",
    "ALL_MODELING_FEATURES = NUMERIC_FEATURES + CATEGORICAL_FEATURES\n",
    "LEAKAGE_COLUMNS = [\n",
    "    \"price_vnd\", \"log_price\", \"Giá\", \"listing_id\", \"Mã tin\",\n",
    "    \"url\", \"URL\", \"Mô tả\", \"Tên xe\", \"Tỉnh thành\"\n",
    "]\n",
    "\n",
    "def extract_features_and_target(df):\n",
    "    \"\"\"Tách ma trận đặc trưng X và vector y, bảo đảm tuyệt đối không có rò rỉ dữ liệu.\"\"\"\n",
    "    avail_cols = [c for c in ALL_MODELING_FEATURES if c in df.columns]\n",
    "    X = df[avail_cols].copy()\n",
    "    y = df[\"price_vnd\"].copy()\n",
    "    \n",
    "    # Kiểm tra an toàn: Không có cột rò rỉ nào trong X\n",
    "    leak_check = [col for col in LEAKAGE_COLUMNS if col in X.columns]\n",
    "    assert len(leak_check) == 0, f\"Phát hiện rò rỉ: {leak_check}\"\n",
    "    return X, y\n",
    "\n",
    "print(f\"Danh sách 8 biến Numeric:     {NUMERIC_FEATURES}\")\n",
    "print(f\"Danh sách 7 biến Categorical: {CATEGORICAL_FEATURES}\")\n",
    "print(f\"Tổng số đặc trưng mô hình:   {len(ALL_MODELING_FEATURES)}\")\n",
    "\n",
    "X, y = extract_features_and_target(clean_df)\n",
    "y_log = np.log(y)\n",
    "print(f\"\\nKích thước ma trận X:     {X.shape}\")\n",
    "print(f\"Kích thước vector y:       {y.shape}\")\n",
    "print(f\"Kích thước vector y_log:   {y_log.shape}\")\n",
    "print(\"[XÁC MINH] Không có bất kỳ cột rò rỉ dữ liệu nào trong ma trận X!\")\n"
   ]
