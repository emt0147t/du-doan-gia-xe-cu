   "source": [
    "RAW_DETAIL_PATH = PROJECT_ROOT / \"data\" / \"raw\" / \"external\" / \"mquaan_car_price\" / \"car_detail.csv\"\n",
    "CLEAN_PHASE5_PATH = PROJECT_ROOT / \"data\" / \"processed\" / \"cars_clean_phase5.csv\"\n",
    "\n",
    "def generate_synthetic_demo_data(n_samples=250, random_state=42):\n",
    "    \"\"\"Tạo tập dữ liệu mô phỏng độc lập đại diện khi không có tệp dữ liệu thật.\"\"\"\n",
    "    np.random.seed(random_state)\n",
    "    archetypes = [\n",
    "        (\"Toyota\", \"Vios\", 1.5, \"Sedan\", \"Xe đã dùng\", False, 480_000_000),\n",
    "        (\"Toyota\", \"Corolla Cross\", 1.8, \"SUV\", \"Xe đã dùng\", False, 750_000_000),\n",
    "        (\"Hyundai\", \"Accent\", 1.4, \"Sedan\", \"Xe đã dùng\", False, 420_000_000),\n",
    "        (\"Hyundai\", \"SantaFe\", 2.2, \"SUV\", \"Xe đã dùng\", False, 1_050_000_000),\n",
    "        (\"Kia\", \"Seltos\", 1.4, \"SUV\", \"Xe đã dùng\", False, 620_000_000),\n",
    "        (\"Kia\", \"Morning\", 1.25, \"Hatchback\", \"Xe đã dùng\", False, 310_000_000),\n",
    "        (\"Mazda\", \"CX-5\", 2.0, \"SUV\", \"Xe đã dùng\", False, 800_000_000),\n",
    "        (\"Mazda\", \"3\", 1.5, \"Sedan\", \"Xe đã dùng\", False, 580_000_000),\n",
    "        (\"Honda\", \"City\", 1.5, \"Sedan\", \"Xe đã dùng\", False, 520_000_000),\n",
    "        (\"Ford\", \"Ranger\", 2.0, \"Bán tải\", \"Xe đã dùng\", False, 720_000_000),\n",
    "        (\"Mercedes-Benz\", \"C200\", 1.5, \"Sedan\", \"Xe đã dùng\", True, 1_450_000_000),\n",
    "        (\"Mercedes-Benz\", \"GLC 300\", 2.0, \"SUV\", \"Xe đã dùng\", True, 2_150_000_000),\n",
    "        (\"Mercedes-Benz\", \"S450\", 3.0, \"Sedan\", \"Xe đã dùng\", True, 4_200_000_000),\n",
    "        (\"BMW\", \"320i\", 2.0, \"Sedan\", \"Xe đã dùng\", True, 1_550_000_000),\n",
    "        (\"Lexus\", \"RX 350\", 3.5, \"SUV\", \"Xe đã dùng\", True, 3_800_000_000),\n",
    "        (\"Porsche\", \"Panamera\", 2.9, \"Sedan\", \"Xe đã dùng\", True, 6_500_000_000),\n",
    "    ]\n",
    "    records = []\n",
    "    for i in range(n_samples):\n",
    "        brand, model, disp, body, cond, is_lux, base_price = archetypes[i % len(archetypes)]\n",
    "        year = int(np.random.randint(2015, 2024))\n",
    "        age = 2024 - year\n",
    "        is_zero = 1 if np.random.rand() < 0.25 else 0\n",
    "        km = 0 if is_zero else int(age * np.random.uniform(9000, 22000))\n",
    "        cond_val = \"Xe mới\" if is_zero else \"Xe đã dùng\"\n",
    "        depr = 0.045 * age + (0.0000012 * km)\n",
    "        noise = np.random.normal(0, 0.07)\n",
    "        price = int(base_price * max(0.35, (1.0 - depr + noise)))\n",
    "        \n",
    "        ty = price // 1_000_000_000\n",
    "        tr = (price % 1_000_000_000) // 1_000_000\n",
    "        if ty > 0 and tr > 0:\n",
    "            gia_str = f\"{ty} Tỷ {tr} Triệu\"\n",
    "        elif ty > 0:\n",
    "            gia_str = f\"{ty} Tỷ\"\n",
    "        else:\n",
    "            gia_str = f\"{tr} Triệu\"\n",
    "            \n",
    "        records.append({\n",
    "            \"Mã tin\": f\"DEMO_{i+1:05d}\",\n",
    "            \"Hãng\": brand,\n",
    "            \"Grade\": model,\n",
    "            \"Năm sản xuất\": year,\n",
    "            \"Số Km đã đi\": f\"{km:,} Km\",\n",
    "            \"Giá\": gia_str,\n",
    "            \"Động cơ\": f\"Xăng\\t{disp} L\",\n",
    "            \"Hộp số\": \"Tự động\" if np.random.rand() > 0.1 else \"Số tay\",\n",
    "            \"Xuất xứ\": \"Trong nước\" if not is_lux and np.random.rand() > 0.3 else \"Nhập khẩu\",\n",
    "            \"Tình trạng\": cond_val,\n",
    "            \"Dòng xe\": body,\n",
    "            \"Số chỗ ngồi\": \"7 chỗ\" if body in [\"SUV\", \"MPV\"] and np.random.rand() > 0.5 else \"5 chỗ\",\n",
    "            \"Số cửa\": \"4 cửa\" if body == \"Sn\" else \"5 cửa\",\n",
    "            \"Mô tả\": f\"Bán xe {brand} {model} năm {year} màu trắng, đi {km:,} km chính chủ giữ gìn cẩn thận.\"\n",
    "        })\n",
    "    return pd.DataFrame(records)\n",
    "\n",
    "raw_df = None\n",
    "data_mode = None\n",
    "\n",
    "if RAW_DETAIL_PATH.exists():\n",
    "    print(f\"[THÀNH CÔNG] Tìm thấy tệp dữ liệu thô cục bộ: {RAW_DETAIL_PATH.relative_to(PROJECT_ROOT)}\")\n",
    "    raw_df = pd.read_csv(RAW_DETAIL_PATH)\n",
    "    data_mode = \"RAW_ORIGINAL\"\n",
    "    print(f\"Kích thước dữ liệu thô: {raw_df.shape[0]:,} dòng x {raw_df.shape[1]} cột\")\n",
    "elif CLEAN_PHASE5_PATH.exists():\n",
    "    print(f\"[THÔNG BÁO] Nạp tệp đã làm sạch Phase 5 tại: {CLEAN_PHASE5_PATH.relative_to(PROJECT_ROOT)}\")\n",
    "    raw_df = pd.read_csv(CLEAN_PHASE5_PATH)\n",
    "    data_mode = \"CLEANED_PHASE5\"\n",
    "    print(f\"Kích thước dữ liệu Cohort A: {raw_df.shape[0]:,} dòng x {raw_df.shape[1]} cột\")\n",
    "else:\n",
    "    print(\"[MÔ PHỎNG] Không có dữ liệu thật cục bộ. Tự động sinh dữ liệu demo đại diện.\")\n",
    "    raw_df = generate_synthetic_demo_data(n_samples=250)\n",
    "    data_mode = \"SYNTHETIC_DEMO\"\n",
    "    print(f\"Kích thước dữ liệu demo: {raw_df.shape[0]:,} dòng x {raw_df.shape[1]} cột\")\n",
    "\n",
    "print(f\"\\nTrạng thái nguồn dữ liệu hiện tại: {data_mode}\")\n",
    "display(raw_df.head(3))\n"
   ]
  },
