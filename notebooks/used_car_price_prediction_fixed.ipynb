   "source": [
    "from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score\n",
    "from sklearn.ensemble import RandomForestRegressor\n",
    "from sklearn.dummy import DummyRegressor\n",
    "from sklearn.linear_model import Ridge\n",
    "\n",
    "def compute_regression_metrics(y_true, y_pred):\n",
    "    \"\"\"Tính toán đầy đủ các chỉ số đánh giá hồi quy theo giá trị VND thực tế.\"\"\"\n",
    "    y_t = np.asarray(y_true, dtype=\"float64\")\n",
    "    y_p = np.clip(np.asarray(y_pred, dtype=\"float64\"), a_min=0.0, a_max=None)\n",
    "    mae = float(mean_absolute_error(y_t, y_p))\n",
    "    rmse = float(np.sqrt(mean_squared_error(y_t, y_p)))\n",
    "    r2 = float(r2_score(y_t, y_p))\n",
    "    valid = y_t > 0\n",
    "    ape = np.abs((y_t[valid] - y_p[valid]) / y_t[valid]) * 100.0\n",
    "    mape = float(np.mean(ape))\n",
    "    mdape = float(np.median(ape))\n",
    "    return {\"mae\": mae, \"rmse\": rmse, \"r2\": r2, \"mape\": mape, \"mdape\": mdape}\n",
    "\n",
    "# Huấn luyện mô hình Random Forest Champion\n",
    "print(\"Tiến hành fit mô hình Champion RandomForestRegressor (n_estimators=100, max_depth=20)...\")\n",
    "rf_champion = RandomForestRegressor(\n",
    "    n_estimators=100,\n",
    "    max_depth=20,\n",
    "    min_samples_split=5,\n",
    "    min_samples_leaf=2,\n",
    "    random_state=42,\n",
    "    n_jobs=-1\n",
    ")\n",
    "champion_pipeline = Pipeline([\n",
    "    (\"preprocessor\", build_tree_preprocessor()),\n",
    "    (\"regressor\", rf_champion)\n",
    "])\n",
    "\n",
    "champion_pipeline.fit(X_train, y_train_log)\n",
    "print(\"[THÀNH CÔNG] Huấn luyện hoàn tất mô hình Champion Pipeline!\")\n",
    "\n",
    "# Đánh giá trực tiếp trên tập Validation\n",
    "val_preds_log = champion_pipeline.predict(X_val)\n",
    "val_preds = np.exp(val_preds_log)\n",
    "live_val_m = compute_regression_metrics(y_val, val_preds)\n",
    "\n",
    "print(\"\\nKẾT QUẢ ĐÁNH GIÁ TRỰC TIẾP TRÊN TẬP VALIDATION:\")\n",
    "print(f\"- Val MAE:   {live_val_m['mae']:,.0f} VND\")\n",
    "print(f\"- Val RMSE:  {live_val_m['rmse']:,.0f} VND\")\n",
    "print(f\"- Val R²:    {live_val_m['r2']:.4f}\")\n",
    "print(f\"- Val MdAPE: {live_val_m['mdape']:.2f}%\")\n"
   ]
