    "# Trích xuất và bóc tách giá tiền tệ tiếng Việt bằng Regex thuần túy\n",
    "def parse_vietnamese_price_to_vnd(raw_price):\n",
    "    \"\"\"Chuyển đổi chuỗi giá rao bán tiếng Việt sang số nguyên VND.\"\"\"\n",
    "    if raw_price is None or pd.isna(raw_price):\n",
    "        return None\n",
    "    s = str(raw_price).strip().lower()\n",
    "    if not s:\n",
    "        return None\n",
    "    # Lọc các tin không có giá cụ thể\n",
    "    non_indicators = [\"thỏa thuận\", \"thoa thuan\", \"liên hệ\", \"lien he\", \"lh\", \"call\", \"inbox\"]\n",
    "    if any(ind in s for ind in non_indicators):\n",
    "        return None\n",
    "    \n",
    "    # 1. Dạng kết hợp Tỷ và Triệu (vd: '1 tỷ 250 triệu', '2 tỉ 50 tr')\n",
    "    m_comb = re.fullmatch(r\"^(\\d+(?:[.,]\\d+)?)\\s*(?:tỷ|tỉ)\\s+(\\d+(?:[.,]\\d+)?)\\s*(?:triệu|tr)(?:\\s*đồng|\\s*vnd)?$\", s)\n",
    "    if m_comb:\n",
    "        v_ty = float(m_comb.group(1).replace(\",\", \".\"))\n",
    "        v_tr = float(m_comb.group(2).replace(\",\", \".\"))\n",
    "        if v_tr < 1000:\n",
    "            return int(round(v_ty * 1_000_000_000 + v_tr * 1_000_000))\n",
    "    \n",
    "    # 2. Dạng chỉ có Tỷ (vd: '1.25 tỷ', '2 tỷ')\n",
    "    m_ty = re.fullmatch(r\"^(\\d+(?:[.,]\\d+)?)\\s*(?:tỷ|tỉ)(?:\\s*đồng|\\s*vnd)?$\", s)\n",
    "    if m_ty:\n",
    "        v_ty = float(m_ty.group(1).replace(\",\", \".\"))\n",
    "        return int(round(v_ty * 1_000_000_000))\n",
    "        \n",
    "    # 3. Dạng chỉ có Triệu (vd: '850 triệu', '899tr')\n",
    "    m_tr = re.fullmatch(r\"^(\\d+(?:[.,]\\d+)?)\\s*(?:triệu|tr)(?:\\s*đồng|\\s*vnd)?$\", s)\n",
    "    if m_tr:\n",
    "        s_num = m_tr.group(1)\n",
    "        if re.fullmatch(r\"^\\d{1,3}[.,]\\d{3}$\", s_num):\n",
    "            v_tr = float(re.sub(r\"[.,]\", \"\", s_num))\n",
    "        else:\n",
    "            v_tr = float(s_num.replace(\",\", \".\"))\n",
    "        return int(round(v_tr * 1_000_000))\n",
    "        \n",
    "    # 4. Dạng chữ số nguyên thuần hoặc dấu chấm phân cách hàng nghìn (vd: '850.000.000')\n",
    "    cleaned_digits = re.sub(r\"\\s*(?:đồng|dong|vnđ|vnd|đ)$\", \"\", s).strip()\n",
    "    if re.fullmatch(r\"\\d{1,3}(?:\\.\\d{3})+\", cleaned_digits):\n",
    "        return int(cleaned_digits.replace(\".\", \"\"))\n",
    "    if re.fullmatch(r\"\\d+\", cleaned_digits):\n",
    "        val = int(cleaned_digits)\n",
    "        return val if val > 0 else None\n",
    "        \n",
    "    return None\n",
    "\n",
    "eda_df = raw_df.copy()\n",
    "\n",
    "# Chuẩn hóa cột price_vnd\n",
    "if \"price_vnd\" not in eda_df.columns:\n",
    "    if \"Giá\" in eda_df.columns:\n",
    "        eda_df[\"price_vnd\"] = eda_df[\"Giá\"].apply(parse_vietnamese_price_to_vnd)\n",
    "    elif \"price\" in eda_df.columns:\n",
    "        eda_df[\"price_vnd\"] = eda_df[\"price\"].apply(parse_vietnamese_price_to_vnd)\n",
    "\n",
    "valid_prices = eda_df[\"price_vnd\"].dropna()\n",
    "valid_prices = valid_prices[valid_prices >= 30_000_000]\n",
    "\n",
    "mean_p = valid_prices.mean()\n",
    "median_p = valid_prices.median()\n",
    "q25_p = valid_prices.quantile(0.25)\n",
    "q75_p = valid_prices.quantile(0.75)\n",
    "skew_raw = valid_prices.skew()\n",
    "skew_log = np.log(valid_prices).skew()\n",
    "\n",
    "print(\"=\" * 65)\n",
    "print(\"THỐNG KÊ MÔ TẢ BIẾN MỤC TIÊU GIÁ XE (price_vnd)\")\n",
    "print(\"=\" * 65)\n",
    "print(f\"Số lượng bản ghi có giá:     {len(valid_prices):,}\")\n",
    "print(f\"Giá nhỏ nhất (Min):           {valid_prices.min():,.0f} VND ({valid_prices.min()/1e6:.1f} Triệu)\")\n",
    "print(f\"Phân vị 25% (Q1):             {q25_p:,.0f} VND ({q25_p/1e6:.1f} Triệu)\")\n",
    "print(f\"Giá trung vị (Median):        {median_p:,.0f} VND ({median_p/1e6:.1f} Triệu)\")\n",
    "print(f\"Giá trung bình (Mean):        {mean_p:,.0f} VND ({mean_p/1e6:.1f} Triệu)\")\n",
    "print(f\"Phân vị 75% (Q3):             {q75_p:,.0f} VND ({q75_p/1e6:.1f} Triệu)\")\n",
    "print(f\"Giá lớn nhất (Max):           {valid_prices.max():,.0f} VND ({valid_prices.max()/1e9:.2f} Tỷ)\")\n",
    "print(f\"Độ lệch (Skewness) giá thô:   {skew_raw:.2f} (Lệch phải rất nặng)\")\n",
    "print(f\"Độ lệch (Skewness) log price: {skew_log:.2f} (Xấp xỉ phân phối chuẩn đối xứng)\")\n",
    "print(\"=\" * 65)\n",
    "\n",
    "# Trực quan hóa phân phối giá thô vs log price\n",
    "fig, axes = plt.subplots(1, 2, figsize=(15, 5))\n",
    "\n",
    "# Biểu đồ giá thô (cắt ngưỡng 5 tỷ để nhìn rõ phần thân phân phối)\n",
    "sns.histplot(valid_prices[valid_prices <= 5e9] / 1e6, kde=True, bins=45, ax=axes[0], color=\"#2563eb\")\n",
    "axes[0].axvline(median_p / 1e6, color=\"red\", linestyle=\"--\", label=f\"Median ({median_p/1e6:.0f}M)\")\n",
    "axes[0].axvline(mean_p / 1e6, color=\"green\", linestyle=\"--\", label=f\"Mean ({mean_p/1e6:.0f}M)\")\n",
    "axes[0].set_title(\"Phân phối giá thô VND (Cắt ngưỡng <= 5 Tỷ)\", fontsize=13, fontweight=\"bold\")\n",
    "axes[0].set_xlabel(\"Giá (Triệu VNĐ)\")\n",
    "axes[0].set_ylabel(\"Số lượng xe\")\n",
    "axes[0].legend()\n",
    "\n",
    "# Biểu đồ Log Price\n",
    "sns.histplot(np.log(valid_prices), kde=True, bins=45, ax=axes[1], color=\"#10b981\")\n",
    "axes[1].set_title(\"Phân phối Logarithm: ln(price_vnd)\", fontsize=13, fontweight=\"bold\")\n",
    "axes[1].set_xlabel(\"ln(price_vnd)\")\n",
    "axes[1].set_ylabel(\"Số lượng xe\")\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
  },
