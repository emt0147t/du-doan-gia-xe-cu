    "LUXURY_BRANDS = {\n",
    "    \"Mercedes-Benz\", \"BMW\", \"Lexus\", \"Audi\", \"Porsche\",\n",
    "    \"Land Rover\", \"Volvo\", \"Bentley\", \"Rolls-Royce\", \"Jaguar\", \"Maserati\"\n",
    "}\n",
    "\n",
    "def clean_dataset(df_raw, min_year=2015, min_price=30_000_000, max_price=50_000_000_000, max_mileage=1_000_000):\n",
    "    \"\"\"Điều phối toàn bộ quy trình làm sạch dữ liệu và tạo Cohort A chuẩn mực.\"\"\"\n",
    "    df = df_raw.copy()\n",
    "    \n",
    "    # 1. Price\n",
    "    if \"price_vnd\" not in df.columns:\n",
    "        if \"Giá\" in df.columns:\n",
    "            df[\"price_vnd\"] = df[\"Giá\"].apply(parse_vietnamese_price_to_vnd)\n",
    "        elif \"price\" in df.columns:\n",
    "            df[\"price_vnd\"] = df[\"price\"].apply(parse_vietnamese_price_to_vnd)\n",
    "            \n",
    "    # 2. Year\n",
    "    if \"Năm sản xuất\" in df.columns:\n",
    "        df[\"year\"] = pd.to_numeric(df[\"Năm sản xuất\"], errors=\"coerce\")\n",
    "    elif \"year\" in df.columns:\n",
    "        df[\"year\"] = pd.to_numeric(df[\"year\"], errors=\"coerce\")\n",
    "        \n",
    "    # 3. Mileage (ODO)\n",
    "    if \"Số Km đã đi\" in df.columns:\n",
    "        def _parse_km(val):\n",
    "            if pd.isna(val): return np.nan\n",
    "            s = str(val).replace(\"Km\", \"\").replace(\"km\", \"\").replace(\",\", \"\").replace(\".\", \"\").strip()\n",
    "            try:\n",
    "                km = float(s)\n",
    "                return km if 0 <= km <= max_mileage else np.nan\n",
    "            except:\n",
    "                return np.nan\n",
    "        df[\"mileage_km\"] = df[\"Số Km đã đi\"].apply(_parse_km)\n",
    "    elif \"mileage_km\" in df.columns:\n",
    "        df[\"mileage_km\"] = pd.to_numeric(df[\"mileage_km\"], errors=\"coerce\")\n",
    "        \n",
    "    # 4. Categoricals\n",
    "    if \"Hãng\" in df.columns:\n",
    "        df[\"brand\"] = df[\"Hãng\"].astype(str).str.strip().replace({\"Mercedes Benz\": \"Mercedes-Benz\"})\n",
    "    if \"Grade\" in df.columns:\n",
    "        df[\"model\"] = df[\"Grade\"].astype(str).str.strip()\n",
    "    if \"Hộp số\" in df.columns:\n",
    "        df[\"transmission\"] = df[\"Hộp số\"].astype(str).str.strip().replace({\"-\": np.nan, \"Số hỗn hợp\": np.nan, \"nan\": np.nan})\n",
    "    if \"Xuất xứ\" in df.columns:\n",
    "        df[\"origin\"] = df[\"Xuất xứ\"].astype(str).str.strip().replace({\"Lắp ráp trong nước\": \"Trong nước\", \"nan\": np.nan})\n",
    "    if \"Tình trạng\" in df.columns:\n",
    "        df[\"condition\"] = df[\"Tình trạng\"].astype(str).str.strip()\n",
    "    if \"Dòng xe\" in df.columns:\n",
    "        df[\"body_type\"] = df[\"Dòng xe\"].astype(str).str.strip()\n",
    "        \n",
    "    # 5. Engine specs\n",
    "    if \"Động cơ\" in df.columns:\n",
    "        def _get_fuel(val):\n",
    "            if pd.isna(val): return np.nan\n",
    "            s = str(val).lower()\n",
    "            if \"xăng\" in s: return \"Xăng\"\n",
    "            if \"dầu\" in s: return \"Dầu\"\n",
    "            if \"điện\" in s: return \"Điện\"\n",
    "            if \"hybrid\" in s: return \"Hybrid\"\n",
    "            return \"Khác\"\n",
    "            \n",
    "        def _get_disp(val):\n",
    "            if pd.isna(val): return np.nan\n",
    "            for p in str(val).split(\"\\t\"):\n",
    "                p_c = p.replace(\"L\", \"\").replace(\"l\", \"\").strip()\n",
    "                try:\n",
    "                    d = float(p_c)\n",
    "                    if 0.5 <= d <= 10.0: return d\n",
    "                except: continue\n",
    "            return np.nan\n",
    "            \n",
    "        df[\"fuel_type\"] = df[\"Động cơ\"].apply(_get_fuel)\n",
    "        df[\"engine_displacement_l\"] = df[\"Động cơ\"].apply(_get_disp)\n",
    "        \n",
    "    # 6. Capacity\n",
    "    if \"Số chỗ ngồi\" in df.columns:\n",
    "        df[\"seats\"] = df[\"Số chỗ ngồi\"].astype(str).str.extract(r\"(\\d+)\").astype(\"float64\")\n",
    "    if \"Số cửa\" in df.columns:\n",
    "        df[\"doors\"] = df[\"Số cửa\"].astype(str).str.extract(r\"(\\d+)\").astype(\"float64\")\n",
    "        \n",
    "    # 7. Derived Features\n",
    "    df[\"car_age\"] = (2024 - df[\"year\"]).clip(lower=0)\n",
    "    df[\"is_zero_mileage\"] = (df[\"mileage_km\"] == 0).astype(\"int64\")\n",
    "    df[\"is_luxury_brand\"] = df[\"brand\"].isin(LUXURY_BRANDS).astype(\"int64\")\n",
    "    \n",
    "    # Lọc phạm vi Cohort A\n",
    "    valid_mask = (\n",
    "        df[\"price_vnd\"].notna() &\n",
    "        (df[\"price_vnd\"] >= min_price) & (df[\"price_vnd\"] <= max_price) &\n",
    "        df[\"year\"].notna() & (df[\"year\"] >= min_year) &\n",
    "        df[\"transmission\"].notna()\n",
    "    )\n",
    "    df_clean = df[valid_mask].copy()\n",
    "    return df_clean\n",
    "\n",
    "# Thực thi làm sạch hoặc nạp tệp sạch có sẵn\n",
    "if data_mode == \"CLEANED_PHASE5\":\n",
    "    clean_df = raw_df.copy()\n",
    "else:\n",
    "    clean_df = clean_dataset(raw_df, min_year=2015)\n",
    "\n",
    "print(f\"Kích thước tập sạch Cohort A: {clean_df.shape[0]:,} dòng x {clean_df.shape[1]} cột\")\n",
    "print(f\"Số lượng xe ODO = 0 km: {(clean_df['mileage_km'] == 0).sum():,} xe ({(clean_df['mileage_km'] == 0).mean()*100:.1f}%)\")\n",
    "print(f\"Khoảng năm sản xuất: [{clean_df['year'].min():.0f} - {clean_df['year'].max():.0f}]\")\n",
    "print(f\"Giá trung vị Cohort A: {clean_df['price_vnd'].median():,.0f} VND\")\n",
    "display(clean_df[[\"brand\", \"model\", \"year\", \"mileage_km\", \"is_zero_mileage\", \"engine_displacement_l\", \"is_luxury_brand\", \"price_vnd\"]].head(5))\n"
   ]
  },
