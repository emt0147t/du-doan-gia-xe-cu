    "## Phần 7. Pipeline tiền xử lý\n",
    "\n",
    "Dự án dùng `sklearn.compose.ColumnTransformer` để xây dựng hai pipeline:\n",
    "\n",
    "1. `build_tree_preprocessor`: impute biến số bằng median và thêm cờ chỉ báo giá trị thiếu; biến phân loại được impute bằng chuỗi `missing` rồi mã hóa One-Hot. Các mô hình cây thông thường không yêu cầu chuẩn hóa thang đo.\n",
    "2. `build_linear_preprocessor`: dùng cùng cách xử lý thiếu và mã hóa, đồng thời thêm `StandardScaler(with_mean=False)` cho biến số để hỗ trợ các mô hình Ridge/Lasso trên dữ liệu thưa.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "10de829d",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-10-24T05:54:23.757008Z",
     "iopub.status.busy": "2026-10-24T05:54:23.757008Z",
     "iopub.status.idle": "2026-10-24T05:54:24.101965Z",
     "shell.execute_reply": "2026-10-24T05:54:24.101965Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Kích thước ma trận sau One-Hot Encoding cho mô hình Cây: (18808, 378)\n",
      "Định dạng ma trận: <class 'scipy.sparse._csr.csr_matrix'> (Sparse CSR Matrix giúp tối ưu RAM)\n",
      "Kích thước ma trận sau Scaling & Encoding cho mô hình Tuyến tính: (18808, 378)\n"
     ]
    }
   ],
   "source": [
    "from sklearn.compose import ColumnTransformer\n",
    "from sklearn.impute import SimpleImputer\n",
    "from sklearn.preprocessing import OneHotEncoder, StandardScaler\n",
    "from sklearn.pipeline import Pipeline\n",
    "\n",
    "def build_tree_preprocessor(num_cols=NUMERIC_FEATURES, cat_cols=CATEGORICAL_FEATURES):\n",
    "    \"\"\"Đường ống tiền xử lý cho mô hình dạng Cây (Random Forest, HistGradientBoosting).\"\"\"\n",
    "    num_pipe = Pipeline([(\"imputer\", SimpleImputer(strategy=\"median\", add_indicator=True))])\n",
    "    cat_pipe = Pipeline([\n",
    "        (\"imputer\", SimpleImputer(strategy=\"constant\", fill_value=\"missing\")),\n",
    "        (\"encoder\", OneHotEncoder(handle_unknown=\"ignore\", sparse_output=True))\n",
    "    ])\n",
    "    return ColumnTransformer([(\"num\", num_pipe, num_cols), (\"cat\", cat_pipe, cat_cols)], remainder=\"drop\")\n",
    "\n",
    "def build_linear_preprocessor(num_cols=NUMERIC_FEATURES, cat_cols=CATEGORICAL_FEATURES):\n",
    "    \"\"\"Đường ống tiền xử lý cho mô hình Tuyến tính (Ridge, Lasso).\"\"\"\n",
    "    num_pipe = Pipeline([\n",
    "        (\"imputer\", SimpleImputer(strategy=\"median\", add_indicator=True)),\n",
    "        (\"scaler\", StandardScaler(with_mean=False))\n",
    "    ])\n",
    "    cat_pipe = Pipeline([\n",
    "        (\"imputer\", SimpleImputer(strategy=\"constant\", fill_value=\"missing\")),\n",
    "        (\"encoder\", OneHotEncoder(handle_unknown=\"ignore\", sparse_output=True))\n",
    "    ])\n",
    "    return ColumnTransformer([(\"num\", num_pipe, num_cols), (\"cat\", cat_pipe, cat_cols)], remainder=\"drop\")\n",
    "\n",
    "tree_prep = build_tree_preprocessor()\n",
    "linear_prep = build_linear_preprocessor()\n",
    "\n",
    "# Thử nghiệm fit trên Train và transform\n",
    "tree_prep.fit(X_train)\n",
    "X_train_trans = tree_prep.transform(X_train)\n",
    "print(f\"Kích thước ma trận sau One-Hot Encoding cho mô hình Cây: {X_train_trans.shape}\")\n",
    "print(f\"Định dạng ma trận: {type(X_train_trans)} (Sparse CSR Matrix giúp tối ưu RAM)\")\n",
    "\n",
    "linear_prep.fit(X_train)\n",
    "X_train_lin = linear_prep.transform(X_train)\n",
    "print(f\"Kích thước ma trận sau Scaling & Encoding cho mô hình Tuyến tính: {X_train_lin.shape}\")\n"
   ]
  },
